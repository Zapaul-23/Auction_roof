<% content_for :title, "Sign up" %>

<section class="card narrow">
  <h1>Create your account</h1>

  <%= form_with model: @user, url: registration_path, class: "form" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div class="field">
      <%= form.label :name, "Display name" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name" %>
    </div>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
      <small class="muted">At least 8 characters.</small>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= form.submit "Sign up", class: "button" %>
  <% end %>

  <p class="muted">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</section>
