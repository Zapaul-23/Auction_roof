<% content_for :title, "Sell an item – #{@step.humanize}" %>

<section class="card">
  <h1><%= @product.title.presence || "Sell an item" %></h1>
  <%= render "products/wizard_progress", product: @product, current: @step %>

  <%= render "products/steps/image_gallery", product: @product if @step == "images" %>

  <%= form_with model: @product, url: product_step_path(@product, @step), method: :patch, class: "form", multipart: true do |form| %>
    <%= render "shared/form_errors", record: @product %>
    <%= render "products/steps/#{@step}", form: form %>

    <div class="form-actions">
      <% if (previous = Product.previous_step(@step)) %>
        <%= link_to "Back", product_step_path(@product, previous), class: "button button-secondary" %>
      <% end %>
      <%= form.submit "Save draft", name: "save_draft", class: "button button-secondary", formnovalidate: true %>
      <%= form.submit(Product.next_step(@step) ? "Next" : "Review", class: "button") %>
    </div>
  <% end %>
</section>
